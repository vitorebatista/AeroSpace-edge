# Ignore .files/.dirs in the root by default.
# New root .files must be explicitly added with `git add -f`
# New root .directories must be explicitly listed below
/.*

# Unignored top level .dirs
!/.bundle
!/.claude
!/.github

/Gemfile.lock
/xcode/.xcode-build

# XCode User settings
xcuserdata/
xcshareddata/

# Claude Code agent worktrees (transient). Skills under .claude/skills/ are tracked.
/.claude/worktrees

# Local Codex worktrees (/.worktrees) and trace bundles / benchmark results (/.benchmarks)
# are covered by the root `/.*` rule above and must never be committed.
